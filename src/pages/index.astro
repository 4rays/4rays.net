---
import { changeLanguage } from "i18next";
import Base from "@layouts/Base.astro";
import Footer from "@components/Footer.astro";
import CompanyLogo from "@components/CompanyLogo.astro";
import CircleLink from "@components/CircleLink.astro";
import LatticeBackground from "@components/LatticeBackground.astro";
import { SITE_EMAIL } from "@consts";
import { PROJECTS } from "../data/projects";

changeLanguage("en");

const monogram = (name: string) =>
  name
    .split(/\s+/)
    .map((word) => word[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
---

<Base title="Four Rays | Home">
  <LatticeBackground />
  <div class="page-wrapper">
    <main>
      <header class="hero">
        <CompanyLogo />
        <h1 class="wordmark">Four Rays</h1>
        <p class="intro">
          We build cutting-edge, AI-native, human-friendly <em>digital products</em>.
        </p>
      </header>

      <section class="work" aria-labelledby="work-heading">
        <h2 id="work-heading">What we're working on</h2>
        <ul role="list" class="circles">
          {
            PROJECTS.map((project) => (
              <CircleLink href={project.href} name={project.name} tagline={project.tagline}>
                {project.image ? (
                  <img src={project.image} alt="" width="256" height="256" loading="lazy" />
                ) : (
                  <span class="monogram" lang={project.markLang}>
                    {project.mark ?? monogram(project.name)}
                  </span>
                )}
              </CircleLink>
            ))
          }
          <CircleLink href={`mailto:${SITE_EMAIL}`} name="Get in touch" tagline={SITE_EMAIL} variant="contact">
            <svg class="orbit-text" viewBox="0 0 100 100" aria-hidden="true">
              <defs>
                <path id="contact-orbit" d="M50,50 m-39,0 a39,39 0 1,1 78,0 a39,39 0 1,1 -78,0"></path>
              </defs>
              <text>
                <textPath href="#contact-orbit" textLength="243" lengthAdjust="spacing">
                  Say hello · Start a project ·
                </textPath>
              </text>
            </svg>
            <svg class="mail-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.5 6.5h17v11h-17z"></path>
              <path d="m3.5 6.5 8.5 7 8.5-7"></path>
            </svg>
          </CircleLink>
        </ul>
      </section>
    </main>
    <Footer />
  </div>
</Base>

<script>
  // Light up the lattice behind a circle when it is hovered or focused.
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-circle]")) {
    const orb = link.querySelector<HTMLElement>(".orb");
    if (!orb) continue;

    const burst = () => {
      const r = orb.getBoundingClientRect();
      window.dispatchEvent(
        new CustomEvent("rays:burst", {
          detail: { x: r.left + r.width / 2, y: r.top + r.height / 2 },
        }),
      );
    };

    link.addEventListener("pointerenter", burst);
    link.addEventListener("focus", burst);
  }
</script>

<style>
  @custom-media --small-viewport (max-width: 38em);

  .page-wrapper {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1 0 auto;
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .wordmark {
    margin: 2.25rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.6vw, 2.4rem);
    font-weight: 200;
    letter-spacing: 0.42em;
    /* Optical centring: trailing tracking would push the word left. */
    margin-right: -0.42em;
    line-height: 1;
    text-transform: uppercase;
    animation: rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }

  .intro {
    max-width: 32ch;
    margin: 1.75rem 0 0;
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0.01em;
    color: var(--text-secondary-color);
    text-wrap: balance;
    animation: rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;

    em {
      font-style: normal;
      color: var(--text-primary-color);
      text-decoration: underline;
      text-decoration-color: rgb(var(--accent));
      text-decoration-thickness: 1.5px;
      text-underline-offset: 0.3em;
    }
  }

  .work {
    margin-top: clamp(4.5rem, 12vw, 7rem);
  }

  .work h2 {
    margin: 0 0 2.75rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    color: var(--text-secondary-color);
  }

  .circles {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3rem 2.5rem;
    margin: 0;
    padding: 0;

    @media (--small-viewport) {
      gap: 2.5rem 0.5rem;
    }
  }

  .monogram {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: var(--text-secondary-color);
  }

  .monogram:lang(ja) {
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "YuMincho", "Noto Serif JP", serif;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    /* Optical centring: trailing tracking would push the mark left. */
    margin-right: -0.06em;
  }

  .orbit-text {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: currentColor;
    font-family: var(--font-display);
    font-size: 7.6px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    animation: orbit 28s linear infinite;
  }

  .mail-icon {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-linecap: round;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .orbit-text {
    transition: rotate 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* `rotate` composes with the running `transform` spin, so it never jumps. */
  :global(.contact:is(:hover, :focus-visible)) .orbit-text {
    rotate: 120deg;
  }

  :global(.contact:is(:hover, :focus-visible)) .mail-icon {
    transform: translateY(-2px) rotate(-8deg);
  }

  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes rise {
    from {
      opacity: 0.3;
      transform: translateY(0.5rem);
      filter: blur(5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark,
    .intro {
      animation: none;
    }

    .orbit-text {
      animation: none;
    }
  }
</style>
