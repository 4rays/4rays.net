---
import Base from "@/layouts/Base.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import CompanyLogo from "@/components/CompanyLogo.astro";
import {
  getLocaleFromParams,
  getLocaleStaticPaths,
  useTranslations
} from "@/i18n/utils";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = getLocaleFromParams(Astro.params);
const t = useTranslations(locale);
---

<Base title={t.home.title} locale={locale}>
  <div class="page-wrapper">
    <main>
      <CompanyLogo />
      <h1><span class="text-gradient">FOUR RAYS</span></h1>
      <p class="intro">
        {t.home.intro.lead}<em>{t.home.intro.emphasis}</em>{t.home.intro.trail}
      </p>
      <ul role="list" class="link-card-grid">
        <Card
          href="/"
          title={t.home.services.title}
          body={t.home.services.body}
        />
        <Card
          href="mailto:contact@4rays.net"
          title={t.home.contact.title}
          body={t.home.contact.body}
        />
      </ul>
    </main>
    <Footer locale={locale} />
  </div>
</Base>

<style>
  @custom-media --small-viewport (max-width: 38em);

  html {
    font-family: system-ui, sans-serif;
    background: var(--background-color);
  }

  .page-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    color: var(--text-primary-color);
    font-size: 1.2rem;
    line-height: 1.6;
    flex: 1 0 auto;
  }

  .text-gradient {
    font-weight: 200;
    margin-top: 0.5em;
    display: block;
  }

  @keyframes outline {
    0% {
      stroke-dashoffset: 400;
    }
    50% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: 400;
    }
  }

  h1 {
    font-size: 1.8rem;
    letter-spacing: 0.6rem;
    font-weight: 100;
    line-height: 1;
    text-align: center;
    margin-top: 0.67em;
    margin-bottom: 3em;
  }

  .intro {
    border-radius: 8px;
    border: 2px solid rgba(var(--accent), 25%);
    color: rgba(var(--accent));
    letter-spacing: 0.1rem;
    margin-top: 1em;
    margin-bottom: 2rem;
    padding: 1.5rem 3rem;
    text-align: center;

    em {
      text-decoration: underline;
    }

    @media (--small-viewport) {
      font-size: 1rem;
      padding: 1rem;
    }
  }

  .intro a {
    color: inherit;
    text-decoration: underline;
  }

  .link-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
    gap: 2rem;
    margin-block: 1em;
    padding: 0;
  }
</style>
