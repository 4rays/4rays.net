---
import Base from "./Base.astro";
import {defaultLocale, type Locale} from "@/i18n/constants";

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  frontmatter?: {title?: string; description?: string};
}

const {locale = defaultLocale} = Astro.props;
const {title, description} = Astro.props.frontmatter || Astro.props;
---

<Base title={title} description={description} locale={locale}>
  <main
    class="prose dark:prose-invert mx-auto w-full px-5 py-16 sm:px-10 sm:py-32"
  >
    <slot />
  </main>
</Base>

<style>
  :root {
    --background-color: #1e1f22;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --background-color: #fff;
    }
  }

  html {
    background-color: var(--background-color);
  }
</style>
