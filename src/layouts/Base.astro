---
import type {Locale} from "@/i18n/constants";
import {useTranslations} from "@/i18n/utils";
import "@/styles.css";

interface Props {
  title?: string;
  description?: string;
  previewImage?: string;
  locale: Locale;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {locale} = Astro.props;
const t = useTranslations(locale);

let {
  title = t.site.title,
  description = t.site.description,
  previewImage
} = Astro.props;

const previewImageURL = previewImage
  ? new URL(previewImage, Astro.site)
  : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />

    <!-- Icons -->
    <!-- <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png?v=2"
    />
    <link rel="mask-icon" href="/safari-pinned-tab.svg?v=2" color="#5bbad5" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <meta name="apple-mobile-web-app-title" content="Reda Lemeden" />
    <meta name="application-name" content="Reda Lemeden" />
    <meta name="msapplication-TileColor" content="#ffc40d" />
    <meta name="theme-color" content="#000000" /> -->

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Additional Meta Tags -->
    <slot name="head" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    {previewImageURL && <meta property="og:image" content={previewImageURL} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  @font-face {
    font-family: "Unbounded";
    src: url("/fonts/unbounded-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 200 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    color-scheme: dark light;
    --font-display: "Unbounded", system-ui, sans-serif;
    --font-body:
      system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

    --accent: 237 103 44;
    --accent-ink: rgb(244 128 76);
    --on-accent-color: #13151a;
    --background-color: #13151a;
    --card-color: #1d2027;
    --hairline: rgb(255 255 255 / 0.1);
    --text-primary-color: #f2f5f8;
    --text-secondary-color: rgb(242 245 248 / 0.66);
    --logo-color: aliceblue;

    --lattice-base: rgb(240 248 255 / 0.045);
    --lattice-ambient: 240 248 255;
    --lattice-ambient-alpha: 0.3;
    --lattice-calm: 200 206 214;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --accent-ink: rgb(184 66 16);
      --background-color: #fbfaf8;
      --card-color: #fff;
      --hairline: rgb(35 38 45 / 0.12);
      --text-primary-color: #1d2027;
      --text-secondary-color: rgb(29 32 39 / 0.68);
      --logo-color: #e6440e;

      --lattice-base: rgb(35 38 45 / 0.06);
      --lattice-ambient: 230 68 14;
      --lattice-ambient-alpha: 0.32;
      --lattice-calm: 150 156 166;
    }
  }

  html {
    background: var(--background-color);
    color: var(--text-primary-color);
    font-family: var(--font-body);
    scrollbar-color: rgb(var(--accent) / 0.5) transparent;
    -webkit-font-smoothing: antialiased;
  }

  body {
    margin: 0;
  }

  ::selection {
    background: rgb(var(--accent));
    color: var(--on-accent-color);
  }

  :focus-visible {
    outline: 2px solid rgb(var(--accent));
    outline-offset: 4px;
  }

  main {
    box-sizing: content-box;
    margin: auto;
    padding: 1rem;
    width: 56rem;
    max-width: calc(100% - 2rem);
  }
</style>
