---
/**
 * Full-page triangular lattice — the grid the Four Rays mark is drawn on.
 *
 * - A faint base grid always shows.
 * - A sparse set of edges trace in and out on staggered timers, like the logo.
 * - The pointer leaves a fading accent trail that draws edges in from its side.
 * - On load, a wave radiates out from the logo.
 * - After a few idle seconds (or on touch devices), a slow ghost path keeps it alive.
 *
 * Listens for `rays:burst` (detail: { x, y } in client coords) for extra energy.
 */
---

<canvas class="lattice" aria-hidden="true"></canvas>

<script>
  const SIDE = 56;
  const ROW_H = (SIDE * Math.sqrt(3)) / 2;
  const TRAIL_RADIUS = 110;
  const DECAY_SECONDS = 1.1;
  const DRAW_SECONDS = 0.38;
  const AMBIENT_SHARE = 0.07;
  const IDLE_MS = 5000;

  const canvas = document.querySelector<HTMLCanvasElement>("canvas.lattice")!;
  const ctx = canvas.getContext("2d")!;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const darkScheme = window.matchMedia("(prefers-color-scheme: dark)");

  // Lattice storage. Edges live in rows; each node owns three edges:
  // 0 = horizontal right, 1 = down-left, 2 = down-right.
  let cols = 0;
  let rows = 0;
  let iMin = -1;
  let originX = 0;
  let originY = 0;
  let x1 = new Float32Array(0);
  let y1 = new Float32Array(0);
  let x2 = new Float32Array(0);
  let y2 = new Float32Array(0);
  let phase = new Float32Array(0);
  let period = new Float32Array(0);
  let ambient = new Uint8Array(0);
  let energy = new Float32Array(0);
  let drawT = new Float32Array(0);
  let flip = new Uint8Array(0);
  // 0 = full accent at the page edges, 1 = calm grey over the reading column.
  let calm = new Float32Array(0);
  // Opacity factor: low at the centre line, 1 away from it.
  let quiet = new Float32Array(0);
  const active = new Set<number>();

  let dpr = 1;
  let viewW = 0;
  let viewH = 0;
  let docH = 0;

  let colors = { base: "" };

  // Line colours step from their own colour (sides) to calm grey (centre).
  const CALM_STEPS = 10;
  // Opacity of fully grey lines, relative to the coloured ones.
  const CALM_ALPHA = 0.5;
  // Opacity right at the centre line, where the text sits.
  const CORE_ALPHA = 0.3;
  let trailPalette: string[] = [];
  let ambientPalette: string[] = [];
  let ambientAlpha = 0.3;

  function triplet(value: string, fallback: number[]) {
    const parts = value.trim().split(/[\s,]+/).map(Number);
    return parts.length === 3 && parts.every((n) => Number.isFinite(n)) ? parts : fallback;
  }

  function readColors() {
    const style = getComputedStyle(document.documentElement);
    colors = {
      base: style.getPropertyValue("--lattice-base").trim() || "rgba(255,255,255,0.05)",
    };
    const accent = triplet(style.getPropertyValue("--accent"), [237, 103, 44]);
    const ambientColor = triplet(style.getPropertyValue("--lattice-ambient"), [240, 248, 255]);
    const grey = triplet(style.getPropertyValue("--lattice-calm"), [200, 206, 214]);
    const alpha = parseFloat(style.getPropertyValue("--lattice-ambient-alpha"));
    ambientAlpha = Number.isFinite(alpha) ? alpha : 0.3;
    const palette = (from: number[]) =>
      Array.from({ length: CALM_STEPS }, (_, step) => {
        const t = step / (CALM_STEPS - 1);
        const mix = from.map((a, n) => Math.round(a + (grey[n] - a) * t));
        return `rgb(${mix.join(" ")})`;
      });
    trailPalette = palette(accent);
    ambientPalette = palette(ambientColor);
  }

  /** Set the stroke colour for edge `e` and return its opacity factor. */
  function tint(e: number, palette: string[]) {
    const c = calm[e];
    ctx.strokeStyle = palette[Math.round(c * (CALM_STEPS - 1))];
    return quiet[e] * (1 - c * (1 - CALM_ALPHA));
  }

  const smoothstep = (edge0: number, edge1: number, x: number) => {
    const t = Math.min(1, Math.max(0, (x - edge0) / (edge1 - edge0)));
    return t * t * (3 - 2 * t);
  };

  // Deterministic per-node hash so the pattern is stable across rebuilds.
  function hash(i: number, j: number, k: number) {
    let h = (i * 374761393 + j * 668265263 + k * 2147483647) | 0;
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    h ^= h >>> 16;
    return (h >>> 0) / 4294967295;
  }

  function anchor() {
    // Align a lattice node with the centre of the logo.
    const logo = document.querySelector(".logo");
    if (!logo) return { x: viewW / 2, y: 200 };
    const r = logo.getBoundingClientRect();
    return { x: r.left + r.width / 2, y: r.top + window.scrollY + r.height / 2 };
  }

  let anchorPoint = { x: 0, y: 0 };

  function build() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    viewW = window.innerWidth;
    viewH = window.innerHeight;
    docH = Math.max(document.documentElement.scrollHeight, viewH);

    canvas.width = Math.round(viewW * dpr);
    canvas.height = Math.round(viewH * dpr);

    anchorPoint = anchor();
    originX = (anchorPoint.x % SIDE) - SIDE;
    const twoRows = ROW_H * 2;
    originY = (anchorPoint.y % twoRows) - twoRows;

    cols = Math.ceil((viewW - originX) / SIDE) + 3;
    rows = Math.ceil((docH - originY) / ROW_H) + 2;
    const n = cols * rows * 3;

    x1 = new Float32Array(n);
    y1 = new Float32Array(n);
    x2 = new Float32Array(n);
    y2 = new Float32Array(n);
    phase = new Float32Array(n);
    period = new Float32Array(n);
    ambient = new Uint8Array(n);
    energy = new Float32Array(n);
    drawT = new Float32Array(n);
    flip = new Uint8Array(n);
    calm = new Float32Array(n);
    quiet = new Float32Array(n);
    active.clear();

    // Grey only in a narrow band at the centre; colour returns quickly.
    const centerX = viewW / 2;
    const greyHalf = Math.min(viewW * 0.12, 170);
    const colorHalf = Math.max(greyHalf + 140, Math.min(viewW * 0.3, 420));
    // Opacity dips right at the centre line, behind the text.
    const coreHalf = Math.min(viewW * 0.2, 280);

    const node = (i: number, j: number) => ({
      x: originX + i * SIDE + (j % 2 ? SIDE / 2 : 0),
      y: originY + j * ROW_H,
    });

    for (let j = 0; j < rows; j++) {
      for (let c = 0; c < cols; c++) {
        const i = c + iMin;
        const p = node(i, j);
        const right = node(i + 1, j);
        const downLeft = j % 2 ? node(i, j + 1) : node(i - 1, j + 1);
        const downRight = j % 2 ? node(i + 1, j + 1) : node(i, j + 1);
        const ends = [right, downLeft, downRight];
        for (let k = 0; k < 3; k++) {
          const e = (j * cols + c) * 3 + k;
          x1[e] = p.x;
          y1[e] = p.y;
          x2[e] = ends[k].x;
          y2[e] = ends[k].y;
          const h = hash(i, j, k);
          ambient[e] = h < AMBIENT_SHARE ? 1 : 0;
          phase[e] = hash(j, i, k + 7);
          period[e] = 7 + hash(k, j, i) * 9;
          const mid = Math.abs((x1[e] + x2[e]) / 2 - centerX);
          calm[e] = 1 - smoothstep(greyHalf, colorHalf, mid);
          quiet[e] = CORE_ALPHA + (1 - CORE_ALPHA) * smoothstep(0, coreHalf, mid);
        }
      }
    }
  }

  function rowRange(top: number, bottom: number) {
    const from = Math.max(0, Math.floor((top - originY) / ROW_H) - 1);
    const to = Math.min(rows - 1, Math.ceil((bottom - originY) / ROW_H) + 1);
    return [from, to];
  }

  /** Add energy to edges near (x, y) in document coordinates. */
  function energize(x: number, y: number, radius: number, strength: number) {
    const [jFrom, jTo] = rowRange(y - radius, y + radius);
    const cFrom = Math.max(0, Math.floor((x - radius - originX) / SIDE) - iMin - 1);
    const cTo = Math.min(cols - 1, Math.ceil((x + radius - originX) / SIDE) - iMin + 1);
    for (let j = jFrom; j <= jTo; j++) {
      for (let c = cFrom; c <= cTo; c++) {
        for (let k = 0; k < 3; k++) {
          const e = (j * cols + c) * 3 + k;
          const mx = (x1[e] + x2[e]) / 2;
          const my = (y1[e] + y2[e]) / 2;
          const d = Math.hypot(mx - x, my - y);
          if (d > radius) continue;
          const t = 1 - d / radius;
          const value = strength * t * t * (3 - 2 * t);
          if (value <= energy[e]) continue;
          if (energy[e] < 0.04) {
            // Fresh edge: draw it in from the end nearest the source.
            drawT[e] = 0;
            flip[e] =
              Math.hypot(x2[e] - x, y2[e] - y) < Math.hypot(x1[e] - x, y1[e] - y) ? 1 : 0;
          }
          energy[e] = value;
          active.add(e);
        }
      }
    }
  }

  function energizePath(ax: number, ay: number, bx: number, by: number, strength: number) {
    const steps = Math.max(1, Math.ceil(Math.hypot(bx - ax, by - ay) / 14));
    for (let s = 1; s <= steps; s++) {
      const t = s / steps;
      energize(ax + (bx - ax) * t, ay + (by - ay) * t, TRAIL_RADIUS, strength);
    }
  }

  const easeOut = (t: number) => 1 - Math.pow(1 - t, 4);

  function segment(e: number, amount: number, reverse: boolean) {
    const sx = reverse ? x2[e] : x1[e];
    const sy = reverse ? y2[e] : y1[e];
    const ex = reverse ? x1[e] : x2[e];
    const ey = reverse ? y1[e] : y2[e];
    ctx.moveTo(sx, sy);
    ctx.lineTo(sx + (ex - sx) * amount, sy + (ey - sy) * amount);
  }

  // Pointer + idle ghost state, in document coordinates.
  let pointer: { x: number; y: number } | null = null;
  let lastPointerAt = -Infinity;
  let ghost: { x: number; y: number } | null = null;
  let start = performance.now();
  let last = start;
  const WAVE_SPEED = 900;
  const WAVE_WIDTH = 140;

  function frame(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    const time = (now - start) / 1000;
    const scrollY = window.scrollY;
    const [jFrom, jTo] = rowRange(scrollY, scrollY + viewH);

    // Load wave from the logo.
    const waveR = time * WAVE_SPEED;
    const waveMax = Math.hypot(viewW, docH);
    if (waveR - WAVE_WIDTH < waveMax) {
      for (let j = jFrom; j <= jTo; j++) {
        for (let c = 0; c < cols; c++) {
          for (let k = 0; k < 3; k++) {
            const e = (j * cols + c) * 3 + k;
            const d = Math.hypot(
              (x1[e] + x2[e]) / 2 - anchorPoint.x,
              (y1[e] + y2[e]) / 2 - anchorPoint.y,
            );
            const lag = waveR - d;
            if (lag < 0 || lag > WAVE_WIDTH) continue;
            const falloff = Math.max(0.15, 1 - d / 900);
            const value = 0.55 * falloff * (1 - lag / WAVE_WIDTH);
            if (value > energy[e]) {
              if (energy[e] < 0.04) {
                drawT[e] = 0;
                flip[e] =
                  Math.hypot(x2[e] - anchorPoint.x, y2[e] - anchorPoint.y) <
                  Math.hypot(x1[e] - anchorPoint.x, y1[e] - anchorPoint.y)
                    ? 1
                    : 0;
              }
              energy[e] = value;
              active.add(e);
            }
          }
        }
      }
    }

    // Idle ghost: a slow Lissajous path through the viewport.
    if (now - lastPointerAt > IDLE_MS) {
      const g = {
        x: viewW * (0.5 + 0.42 * Math.sin(time * 0.23)),
        y: scrollY + viewH * (0.5 + 0.4 * Math.sin(time * 0.31 + 1.3)),
      };
      if (ghost) energizePath(ghost.x, ghost.y, g.x, g.y, 0.4);
      ghost = g;
    } else {
      ghost = null;
    }

    // Decay energy.
    const decay = Math.exp(-dt / DECAY_SECONDS);
    for (const e of active) {
      energy[e] *= decay;
      drawT[e] = Math.min(1, drawT[e] + dt / DRAW_SECONDS);
      if (energy[e] < 0.01) {
        energy[e] = 0;
        active.delete(e);
      }
    }

    ctx.setTransform(dpr, 0, 0, dpr, 0, -scrollY * dpr);
    ctx.clearRect(0, scrollY, viewW, viewH);
    ctx.lineCap = "round";

    // Base grid in a single path.
    ctx.beginPath();
    for (let j = jFrom; j <= jTo; j++) {
      for (let c = 0; c < cols; c++) {
        for (let k = 0; k < 3; k++) {
          const e = (j * cols + c) * 3 + k;
          ctx.moveTo(x1[e], y1[e]);
          ctx.lineTo(x2[e], y2[e]);
        }
      }
    }
    ctx.lineWidth = 1;
    ctx.strokeStyle = colors.base;
    ctx.stroke();

    // Ambient traces: draw in, hold, draw out — each on its own clock.
    ctx.lineWidth = 1;
    for (let j = jFrom; j <= jTo; j++) {
      for (let c = 0; c < cols; c++) {
        for (let k = 0; k < 3; k++) {
          const e = (j * cols + c) * 3 + k;
          if (!ambient[e]) continue;
          const p = (time / period[e] + phase[e]) % 1;
          // 0–.25 draw in, .25–.45 hold, .45–.7 draw out from the start, rest hidden.
          let from = 0;
          let to = 0;
          if (p < 0.25) to = easeOut(p / 0.25);
          else if (p < 0.45) to = 1;
          else if (p < 0.7) {
            from = easeOut((p - 0.45) / 0.25);
            to = 1;
          } else continue;
          const dx = x2[e] - x1[e];
          const dy = y2[e] - y1[e];
          ctx.globalAlpha = ambientAlpha * tint(e, ambientPalette);
          ctx.beginPath();
          ctx.moveTo(x1[e] + dx * from, y1[e] + dy * from);
          ctx.lineTo(x1[e] + dx * to, y1[e] + dy * to);
          ctx.stroke();
        }
      }
    }

    // Energised edges: accent at the sides, quieter grey over the text.
    ctx.lineWidth = 1.25;
    for (const e of active) {
      if (y1[e] > scrollY + viewH + ROW_H || y2[e] < scrollY - ROW_H) continue;
      ctx.globalAlpha = Math.min(1, energy[e] * 1.1) * tint(e, trailPalette);
      ctx.beginPath();
      segment(e, easeOut(drawT[e]), flip[e] === 1);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;

    raf = requestAnimationFrame(frame);
  }

  function drawStatic() {
    const scrollY = window.scrollY;
    const [jFrom, jTo] = rowRange(scrollY, scrollY + viewH);
    ctx.setTransform(dpr, 0, 0, dpr, 0, -scrollY * dpr);
    ctx.clearRect(0, scrollY, viewW, viewH);
    ctx.lineCap = "round";
    ctx.lineWidth = 1;

    ctx.beginPath();
    for (let j = jFrom; j <= jTo; j++) {
      for (let c = 0; c < cols; c++) {
        for (let k = 0; k < 3; k++) {
          const e = (j * cols + c) * 3 + k;
          ctx.moveTo(x1[e], y1[e]);
          ctx.lineTo(x2[e], y2[e]);
        }
      }
    }
    ctx.strokeStyle = colors.base;
    ctx.stroke();

    for (let j = jFrom; j <= jTo; j++) {
      for (let c = 0; c < cols; c++) {
        for (let k = 0; k < 3; k++) {
          const e = (j * cols + c) * 3 + k;
          if (!ambient[e] || phase[e] > 0.4) continue;
          ctx.globalAlpha = ambientAlpha * tint(e, ambientPalette);
          ctx.beginPath();
          ctx.moveTo(x1[e], y1[e]);
          ctx.lineTo(x2[e], y2[e]);
          ctx.stroke();
        }
      }
    }
    ctx.globalAlpha = 1;
  }

  let raf = 0;

  function run() {
    cancelAnimationFrame(raf);
    if (reducedMotion.matches) {
      drawStatic();
    } else {
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }
  }

  function toDoc(e: PointerEvent) {
    return { x: e.clientX, y: e.clientY + window.scrollY };
  }

  window.addEventListener(
    "pointermove",
    (e) => {
      if (reducedMotion.matches) return;
      const p = toDoc(e);
      if (pointer && performance.now() - lastPointerAt < 200) {
        energizePath(pointer.x, pointer.y, p.x, p.y, 0.9);
      } else {
        energize(p.x, p.y, TRAIL_RADIUS, 0.9);
      }
      pointer = p;
      lastPointerAt = performance.now();
    },
    { passive: true },
  );

  window.addEventListener(
    "pointerdown",
    (e) => {
      if (reducedMotion.matches) return;
      const p = toDoc(e);
      energize(p.x, p.y, TRAIL_RADIUS * 1.6, 1);
      pointer = p;
      lastPointerAt = performance.now();
    },
    { passive: true },
  );

  window.addEventListener("rays:burst", (event) => {
    if (reducedMotion.matches) return;
    const { x, y } = (event as CustomEvent<{ x: number; y: number }>).detail;
    energize(x, y + window.scrollY, TRAIL_RADIUS * 1.5, 1);
  });

  window.addEventListener(
    "scroll",
    () => {
      if (reducedMotion.matches) drawStatic();
    },
    { passive: true },
  );

  let resizeTimer = 0;
  let lastSize = "";
  const onResize = () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      const size = `${window.innerWidth}x${window.innerHeight}x${document.documentElement.scrollHeight}`;
      if (size === lastSize) return;
      lastSize = size;
      build();
      run();
    }, 120);
  };
  new ResizeObserver(onResize).observe(document.body);
  window.addEventListener("resize", onResize);

  const onScheme = () => {
    readColors();
    if (reducedMotion.matches) drawStatic();
  };
  darkScheme.addEventListener("change", onScheme);
  reducedMotion.addEventListener("change", run);

  readColors();
  build();
  lastSize = `${window.innerWidth}x${window.innerHeight}x${document.documentElement.scrollHeight}`;
  start = performance.now();
  run();
</script>

<style>
  .lattice {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>
