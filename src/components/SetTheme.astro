<script is:inline>
  function getThemePreference() {
    try {
      const storedTheme = localStorage.getItem("theme");
      // Ignore anything outside the known values.
      if (["light", "dark", "system"].includes(storedTheme)) {
        return storedTheme;
      }
    } catch {
      // Storage can be unavailable (blocked by policy); follow the system scheme.
    }

    return "system";
  }

  function applyTheme(theme) {
    const isDark =
      theme === "dark" ||
      (theme === "system" &&
        window.matchMedia("(prefers-color-scheme: dark)").matches);

    document.documentElement.classList[isDark ? "add" : "remove"]("dark");
  }

  // Set the theme class before first paint so the page never flashes.
  applyTheme(getThemePreference());

  // Follow live system-scheme changes whenever the resolved preference is
  // system: no stored theme, a stored "system", or an invalid stored value.
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      if (getThemePreference() === "system") {
        applyTheme("system");
      }
    });
</script>
